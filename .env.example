# Copy to .env (git-ignored) and fill in the keys you have. Missing keys are skipped:
# the chain uses whichever providers are configured, in this order.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Optional provider order (first = primary). Default: groq,nvidia,gemini
# MINERLLM_PROVIDERS=groq,nvidia,gemini

# Optional model overrides (defaults in minerllm/llm/providers.py)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=low        # low | medium | high (Gemini 3.x)
# GROQ_MODEL=openai/gpt-oss-120b
# NVIDIA_MODEL=minimaxai/minimax-m3.1-flash     # alternative: nvidia/nemotron-3.5-lightning-30b-a3b
