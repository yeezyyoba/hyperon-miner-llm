# Copy to .env (git-ignored) and fill in the keys you have. Missing keys are skipped:
# the chain uses whichever providers are configured, in this order.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# Optional model overrides (defaults in minerllm/llm/providers.py)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=low        # low | medium | high (Gemini 3.x)
# GROQ_MODEL=llama-3.3-70b-versatile
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
